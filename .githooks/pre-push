#!/bin/sh
# The same fmt, clippy, and ShellCheck gates as CI, run before anything
# leaves this machine. Matters most for direct pushes to main, which
# bypass the PR checks.
# Enable with: git config core.hooksPath .githooks
# Skip once with: git push --no-verify
set -eu

cd "$(git rev-parse --show-toplevel)"

for crate in daemon dsi-blank-retry; do
    echo "pre-push: $crate: fmt + clippy" >&2
    (cd "$crate" && cargo fmt --check && cargo clippy -q --all-targets --locked -- -D warnings)
done

if ! command -v shellcheck >/dev/null 2>&1; then
    echo "pre-push: shellcheck not installed (sudo pacman -S shellcheck)" >&2
    exit 1
fi
echo "pre-push: shellcheck" >&2
shellcheck scripts/*.sh systemd/system-sleep/minibookd .githooks/*
